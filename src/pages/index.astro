---
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import BootToCamera from '../sections/BootToCamera.astro';
import Bento from '../sections/Bento.astro';
import Remote from '../sections/Remote.astro';
import Compat from '../sections/Compat.astro';
import DeckCamSection from '../sections/DeckCamSection.astro';
import Specs from '../sections/Specs.astro';
import Cta from '../sections/Cta.astro';
import Section from '../components/Section.astro';
import Faq from '../components/Faq.astro';

import { FAQS } from '../data/faq';
import {
  getOrganizationSchema,
  getWebSiteSchema,
  getDeckTvAppSchema,
  getDeckCamAppSchema,
  getFaqSchema,
} from '../lib/jsonld';

const jsonLd = [
  getOrganizationSchema(),
  getWebSiteSchema(),
  getDeckTvAppSchema(),
  getDeckCamAppSchema(),
  getFaqSchema(FAQS),
];
---

<Base
  title="DeckTV — Android TV Launcher & Live CCTV Control Room"
  description="DeckTV is a clean Android TV home screen that opens straight into your DVR's cameras when the TV turns on. Hikvision, Dahua, CP Plus and RTSP. Local only, no cloud account."
  path="/"
  jsonLd={jsonLd}
>
  <Hero />
  <BootToCamera />
  <Bento />
  <Remote />
  <Compat />
  <DeckCamSection />
  <Specs />
  <Section
    id="faq"
    eyebrow="FAQ"
    title="Before you install"
    lede="DVR compatibility, boot-to-camera, and what happens to your TV's own home screen."
  >
    <Faq faqs={FAQS} />
  </Section>
  <Cta />
</Base>
