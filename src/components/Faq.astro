---
import type { FaqItem } from '../data/faq';

interface Props {
  faqs: FaqItem[];
  class?: string;
}

const { faqs, class: className = '' } = Astro.props;
---

<div class={`faq-accordion ${className}`}>
  {faqs.map((faq, idx) => (
    <details class="faq-item card" open={idx === 0}>
      <summary class="faq-summary">
        <span class="faq-q-text">{faq.question}</span>
        <span class="faq-icon-wrap" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="faq-chevron">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="faq-answer">
        <p>{faq.answer}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 840px;
    margin: 0 auto;
  }

  .faq-item {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .faq-item:hover {
    border-color: var(--rule-strong);
  }

  .faq-item[open] {
    border-color: var(--rule-strong);
    background: var(--surface-hi);
  }

  .faq-summary {
    list-style: none;
    cursor: pointer;
    padding: 1.375rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-q-text {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .faq-icon-wrap {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--deep);
    border: 1px solid var(--rule);
  }

  .faq-chevron {
    width: 16px;
    height: 16px;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    color: var(--text-dim);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .faq-answer {
    padding: 0 1.75rem 1.5rem 1.75rem;
  }

  .faq-answer p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-dim);
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-summary {
      padding: 1.125rem 1.25rem;
    }
    .faq-q-text {
      font-size: 1rem;
    }
    .faq-answer {
      padding: 0 1.25rem 1.25rem 1.25rem;
    }
  }
</style>
