---
interface Props {
  variant?: 'mark' | 'icon' | 'deckcam' | 'horizontal';
  size?: number | string;
  class?: string;
}

const {
  variant = 'mark',
  size = 32,
  class: className = '',
} = Astro.props;

const dimension = typeof size === 'number' ? `${size}px` : size;
---

{variant === 'mark' && (
  <svg
    viewBox="0 0 108 108"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class={`brand-logo-mark ${className}`}
    style={`width: ${dimension}; height: ${dimension}; display: block; flex-shrink: 0;`}
    aria-hidden="true"
  >
    <!-- TV Outer Bezel -->
    <rect x="15" y="22" width="78" height="54" rx="10" fill="#323A47" stroke="#6E7C8E" stroke-width=".6" />
    <!-- TV Screen Display -->
    <rect x="19" y="26" width="70" height="46" rx="7" fill="#080A0E" />
    <!-- Cam 1 (Focused White Tile with Highlight Stroke) -->
    <rect x="21" y="28" width="32.5" height="20.5" rx="4" fill="#F4F8FC" />
    <rect x="19.8" y="26.8" width="34.9" height="22.9" rx="5" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width=".8" />
    <!-- Cam 2 (Cyan Tile) -->
    <rect x="55.5" y="28" width="32.5" height="20.5" rx="4" fill="#4DB8F5" />
    <!-- Cam 3 (Cyan Tile) -->
    <rect x="21" y="50.5" width="32.5" height="20.5" rx="4" fill="#4DB8F5" />
    <!-- Cam 4 (Deep Blue/Cyan Tile) -->
    <rect x="55.5" y="50.5" width="32.5" height="20.5" rx="4" fill="#2F8FE0" />
    <!-- Live Recording Red Indicator -->
    <circle cx="82.5" cy="33.5" r="2.6" fill="#FF453A" />
    <!-- TV Stand Base -->
    <rect x="40" y="79.5" width="28" height="4" rx="2" fill="#6E7C8E" />
  </svg>
)}

{variant === 'icon' && (
  <svg
    viewBox="0 0 108 108"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class={`brand-logo-icon ${className}`}
    style={`width: ${dimension}; height: ${dimension}; display: block; flex-shrink: 0;`}
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="logo-icon-bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1E2836" />
        <stop offset="1" stop-color="#090B0F" />
      </linearGradient>
    </defs>
    <!-- Rounded App Icon Plate -->
    <rect width="108" height="108" rx="24.3" fill="url(#logo-icon-bg)" />
    <!-- TV Outer Bezel -->
    <rect x="15" y="22" width="78" height="54" rx="10" fill="#323A47" stroke="#6E7C8E" stroke-width=".6" />
    <!-- TV Screen Display -->
    <rect x="19" y="26" width="70" height="46" rx="7" fill="#080A0E" />
    <!-- Cam 1 (Focused White Tile with Highlight Stroke) -->
    <rect x="21" y="28" width="32.5" height="20.5" rx="4" fill="#F4F8FC" />
    <rect x="19.8" y="26.8" width="34.9" height="22.9" rx="5" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width=".8" />
    <!-- Cam 2 (Cyan Tile) -->
    <rect x="55.5" y="28" width="32.5" height="20.5" rx="4" fill="#4DB8F5" />
    <!-- Cam 3 (Cyan Tile) -->
    <rect x="21" y="50.5" width="32.5" height="20.5" rx="4" fill="#4DB8F5" />
    <!-- Cam 4 (Deep Blue/Cyan Tile) -->
    <rect x="55.5" y="50.5" width="32.5" height="20.5" rx="4" fill="#2F8FE0" />
    <!-- Live Recording Red Indicator -->
    <circle cx="82.5" cy="33.5" r="2.6" fill="#FF453A" />
    <!-- TV Stand Base -->
    <rect x="40" y="79.5" width="28" height="4" rx="2" fill="#6E7C8E" />
  </svg>
)}

{variant === 'deckcam' && (
  <svg
    viewBox="0 0 108 108"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class={`brand-logo-deckcam ${className}`}
    style={`width: ${dimension}; height: ${dimension}; display: block; flex-shrink: 0;`}
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="deckcam-icon-bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1E2836" />
        <stop offset="1" stop-color="#090B0F" />
      </linearGradient>
    </defs>
    <!-- Rounded App Icon Plate -->
    <rect width="108" height="108" rx="24.3" fill="url(#deckcam-icon-bg)" />
    <!-- Camera Body -->
    <path fill="#5AC8FA" d="M34 42h28a5 5 0 0 1 5 5v14a5 5 0 0 1 -5 5h-28a5 5 0 0 1 -5 -5v-14a5 5 0 0 1 5 -5z"/>
    <!-- Camera Lens Triangle -->
    <path fill="#5AC8FA" d="M70 48l10 -6v24l-10 -6z"/>
    <!-- Live Red Indicator -->
    <circle cx="40" cy="46" r="2.4" fill="#FF453A"/>
  </svg>
)}

{variant === 'horizontal' && (
  <svg
    viewBox="0 0 560 108"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class={`brand-logo-horizontal ${className}`}
    style={`height: ${dimension}; width: auto; display: block;`}
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="logo-h-bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1E2836" />
        <stop offset="1" stop-color="#090B0F" />
      </linearGradient>
    </defs>
    <!-- App Icon Plate -->
    <rect width="108" height="108" rx="24.3" fill="url(#logo-h-bg)" />
    <!-- TV Outer Bezel -->
    <rect x="15" y="22" width="78" height="54" rx="10" fill="#323A47" stroke="#6E7C8E" stroke-width=".6" />
    <!-- TV Screen Display -->
    <rect x="19" y="26" width="70" height="46" rx="7" fill="#080A0E" />
    <!-- Cam 1 (Focused White Tile with Highlight Stroke) -->
    <rect x="21" y="28" width="32.5" height="20.5" rx="4" fill="#F4F8FC" />
    <rect x="19.8" y="26.8" width="34.9" height="22.9" rx="5" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width=".8" />
    <!-- Cam 2 (Cyan Tile) -->
    <rect x="55.5" y="28" width="32.5" height="20.5" rx="4" fill="#4DB8F5" />
    <!-- Cam 3 (Cyan Tile) -->
    <rect x="21" y="50.5" width="32.5" height="20.5" rx="4" fill="#4DB8F5" />
    <!-- Cam 4 (Deep Blue/Cyan Tile) -->
    <rect x="55.5" y="50.5" width="32.5" height="20.5" rx="4" fill="#2F8FE0" />
    <!-- Live Recording Red Indicator -->
    <circle cx="82.5" cy="33.5" r="2.6" fill="#FF453A" />
    <!-- TV Stand Base -->
    <rect x="40" y="79.5" width="28" height="4" rx="2" fill="#6E7C8E" />
    <!-- Typography -->
    <text x="130" y="76" fill="#F2F4F7" font-family="'Outfit Variable', sans-serif" font-size="66" font-weight="300" letter-spacing="-1">Deck<tspan fill="#5AC8FA" font-weight="600">TV</tspan></text>
  </svg>
)}
